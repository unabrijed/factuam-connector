{
  "name": "factum",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=20",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@factum/web",
    "dev:api": "turbo run dev --filter=@factum/api",
    "dev:worker": "turbo run dev --filter=@factum/ml-runner",
    "web": "yarn workspace @factum/web dev",
    "api": "yarn workspace @factum/api dev",
    "worker": "yarn workspace @factum/ml-runner dev",
    "dev:axl": "node scripts/dev-axl.mjs",
    "check:axl": "node scripts/check-axl-health.mjs",
    "build": "turbo run build",
    "build:web": "yarn workspace @factum/web build",
    "build:api": "yarn workspace @factum/api build",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:api": "yarn workspace @factum/api typecheck",
    "test": "turbo run test",
    "check:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "check": "yarn typecheck && yarn test",
    "db:generate": "turbo run db:generate --filter=@factum/api",
    "db:migrate": "turbo run db:migrate --filter=@factum/api",
    "clean": "find . \\( -name .next -o -name dist -o -name .turbo -o -name '*.tsbuildinfo' \\) -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "turbo": "^2.0.14",
    "typescript": "^5.6.3"
  }
}
