# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ML_WORKER_URL=http://localhost:8000
PORT=4000
RUN_QUEUE_WORKER=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prooflayer

# Gensyn
GENSYN_REE_ENABLED=false
GENSYN_REE_COMMAND=ree
GENSYN_REE_MODE=reproducible
GENSYN_REE_VERIFIER_MODEL=
GENSYN_AXL_ENABLED=false
GENSYN_AXL_API_URL=http://127.0.0.1:9002
GENSYN_AXL_AGENT_PEERS={"evidence_classifier":"peer_a","experiment_planner":"peer_b","verifier":"peer_c","answer_generator":"peer_d"}
GENSYN_AXL_TIMEOUT_MS=1500
GENSYN_AXL_POLL_INTERVAL_MS=250
GENSYN_AXL_LOCAL_FALLBACK=true
GENSYN_CHAIN_ENABLED=false
GENSYN_CHAIN_RPC=
GENSYN_CHAIN_PRIVATE_KEY=0xYOUR_GENSYN_CHAIN_PRIVATE_KEY
GENSYN_CHAIN_REGISTRY_ADDRESS=0xYOUR_GENSYN_CHAIN_REGISTRY_ADDRESS

# Kaggle
KAGGLE_API_TOKEN=your_kaggle_token_here

# Redis
REDIS_URL=redis://localhost:6379

# OpenCode (run server separately)
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode/gpt-5-nano

# Gensyn REE default model fallback
LLM_MODEL=gpt-4.1-mini

# Files
LOCAL_UPLOAD_DIR=./uploads
LOCAL_ARTIFACT_DIR=./artifacts

# 0G Storage
OG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-standard.0g.ai
OG_STORAGE_PRIVATE_KEY=0xYOUR_0G_STORAGE_PRIVATE_KEY

# 0G Compute
OG_COMPUTE_RPC=https://evmrpc-testnet.0g.ai
OG_COMPUTE_PRIVATE_KEY=0xYOUR_0G_COMPUTE_PRIVATE_KEY
OG_COMPUTE_PROVIDER_ADDRESS=0x0000000000000000000000000000000000000000

# 0G Chain
OG_CHAIN_RPC=https://evmrpc-testnet.0g.ai
OG_CHAIN_PRIVATE_KEY=0xYOUR_0G_CHAIN_PRIVATE_KEY
OG_CHAIN_RECEIPT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
