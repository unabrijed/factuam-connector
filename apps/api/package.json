{
  "name": "@factuam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:axl-classifier": "tsx watch src/axl-workers/evidence-classifier.worker.ts",
    "dev:axl-planner": "tsx watch src/axl-workers/experiment-planner.worker.ts",
    "dev:axl-validation": "tsx watch src/axl-workers/validation.worker.ts",
    "dev:axl-diagnosis": "tsx watch src/axl-workers/diagnosis.worker.ts",
    "dev:axl-strategy": "tsx watch src/axl-workers/strategy.worker.ts",
    "dev:axl-training": "tsx watch src/axl-workers/training.worker.ts",
    "dev:axl-reflection": "tsx watch src/axl-workers/reflection.worker.ts",
    "dev:axl-answer": "tsx watch src/axl-workers/answer-generator.worker.ts",
    "dev:axl-verifier": "tsx watch src/axl-workers/verifier.worker.ts",
    "dev:axl-unified": "tsx watch src/axl-workers/unified-axl.worker.ts",
    "dev:axl": "node ../../scripts/dev-axl.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@factuam/agent-connectors": "*",
    "@factuam/agent-sdk": "*",
    "@factuam/connector-sdk": "*",
    "@factuam/gensyn-axl": "*",
    "@factuam/gensyn-chain": "*",
    "@factuam/gensyn-ree": "*",
    "@factuam/kaggle-connector": "*",
    "@factuam/og-chain": "*",
    "@factuam/og-compute": "*",
    "@factuam/og-storage": "*",
    "@factuam/proof-receipts": "*",
    "@factuam/shared-types": "*",
    "@factuam/url-connector": "*",
    "@hono/node-server": "^1.13.1",
    "@opencode-ai/sdk": "^1.14.33",
    "bullmq": "^5.22.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.34.1",
    "hono": "^4.6.7",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "uuid": "^11.0.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.25.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.4"
  }
}
